<UserControl x:Class="UnoIssueRepros.Issues.Issue10.ThemeLookupRepro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <!--
      The same key in both a MergedDictionary and the ThemeDictionaries of one ResourceDictionary.
      The theme versions are green (Light), teal (Dark) and the system highlight (HighContrast);
      the merged one is red. Which one wins?
    -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
          <SolidColorBrush x:Key="ReproSwatchBrush" Color="#D13438" />
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ReproSwatchBrush" Color="#107C10" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ReproSwatchBrush" Color="#00B7C3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="ReproSwatchBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel Spacing="8">
    <TextBlock TextWrapping="WrapWholeWords">
      Part 1: the key ReproSwatchBrush is defined in the ThemeDictionaries (green or teal) and in a
      MergedDictionary (red) of the same ResourceDictionary. On Uno the merged red wins, so the themed
      value is never used. Please compare with WinUI on Windows.
    </TextBlock>
    <Border x:Name="Swatch"
            Width="220"
            Height="44"
            HorizontalAlignment="Left"
            Background="{ThemeResource ReproSwatchBrush}"
            CornerRadius="4" />
    <TextBlock x:Name="SwatchText" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />

    <TextBlock Margin="0,12,0,0" TextWrapping="WrapWholeWords">
      Part 2: high contrast. Turn Windows contrast themes on (Left Alt + Left Shift + Print Screen), then press
      Refresh. On Uno the app does not switch to its HighContrast theme dictionary by itself; the app has to drive it.
    </TextBlock>
    <Button Click="OnRefresh" Content="Refresh" />
    <TextBlock x:Name="ContrastText" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
