<UserControl x:Class="UnoIssueRepros.Issues.Issue10.ThemeLookupWorkaround"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <!-- Themed keys live ONLY in ThemeDictionaries. Nothing in a merged dictionary shadows them. -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SafeSwatchBrush" Color="#107C10" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SafeSwatchBrush" Color="#00B7C3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="SafeSwatchBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel Spacing="8">
    <TextBlock TextWrapping="WrapWholeWords">
      Keep a themed key in one place: the ThemeDictionaries. If a merged dictionary must supply defaults,
      use a different key there. The swatch below follows the theme; flip it with the buttons (they set
      RequestedTheme on this panel only).
    </TextBlock>
    <StackPanel x:Name="ThemedPanel" Spacing="8">
      <Border x:Name="Swatch"
              Width="220"
              Height="44"
              HorizontalAlignment="Left"
              Background="{ThemeResource SafeSwatchBrush}"
              CornerRadius="4" />
      <TextBlock x:Name="SwatchText" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Click="OnLight" Content="Light" />
      <Button Click="OnDark" Content="Dark" />
      <Button Click="OnDefault" Content="Default" />
    </StackPanel>

    <TextBlock Margin="0,12,0,0" TextWrapping="WrapWholeWords">
      High contrast is app-driven: read AccessibilitySettings.HighContrast (and listen for HighContrastChanged
      where it fires), then switch your own resources, for example by swapping a merged dictionary or setting
      colours from the SystemColor* resources in code.
    </TextBlock>
  </StackPanel>
</UserControl>
