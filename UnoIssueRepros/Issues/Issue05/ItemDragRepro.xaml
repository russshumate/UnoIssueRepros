<UserControl x:Class="UnoIssueRepros.Issues.Issue05.ItemDragRepro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Spacing="8">
    <TextBlock TextWrapping="WrapWholeWords">
      Drag sideways on a tab, then on the plain Border. Each has ManipulationMode="TranslateX" and
      a ManipulationStarted handler. Expected: both start a manipulation. On Uno, SelectorBarItem
      (an ItemContainer) captures the pointer on press, so the per-item manipulation never starts.
    </TextBlock>

    <SelectorBar x:Name="Bar">
      <SelectorBarItem ManipulationMode="TranslateX" Text="Alpha" />
      <SelectorBarItem ManipulationMode="TranslateX" Text="Beta" />
      <SelectorBarItem ManipulationMode="TranslateX" Text="Gamma" />
    </SelectorBar>

    <Border x:Name="PlainBorder"
            Height="44"
            Padding="12,0"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="4"
            ManipulationMode="TranslateX">
      <TextBlock VerticalAlignment="Center" Text="Plain Border (control case): drag me sideways" />
    </Border>

    <TextBlock x:Name="CountsText" FontFamily="Consolas, Menlo, monospace" />
    <TextBlock x:Name="VerdictText" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
