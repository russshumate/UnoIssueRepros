<UserControl
    x:Class="UnoIssueRepros.Issues.Issue23.ClearValueThemeWorkaround"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="ThemedHost" TargetType="ContentControl">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- The conditional look is a second Style, so switching back is a Style swap, never a ClearValue. -->
            <Style x:Key="HighlightedHost" TargetType="ContentControl">
                <Setter Property="Foreground" Value="Red" />
            </Style>
        </Grid.Resources>

        <StackPanel Spacing="8">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" />
            <ContentControl x:Name="Host" Style="{StaticResource ThemedHost}">
                <TextBlock Text="Text inside the Style-themed host" />
            </ContentControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Run again" Click="OnRun" />
            </StackPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontFamily="Consolas, Menlo, monospace" FontSize="12" />
            <TextBlock x:Name="VerdictText" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</UserControl>
