<UserControl x:Class="UnoIssueRepros.Issues.Issue07.UnderlineWorkaround"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Spacing="14">
    <TextBlock TextWrapping="WrapWholeWords">
      Draw the line yourself: a Border with BorderThickness="0,0,0,1" whose BorderBrush is bound to the
      text's Foreground, so it follows theme changes. Left-align it so the line is only as wide as the text.
      It works for a whole TextBlock, not for part of a line.
    </TextBlock>

    <StackPanel Spacing="2">
      <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Border underline" />
      <Border HorizontalAlignment="Left"
              BorderBrush="{Binding Foreground, ElementName=UnderlinedText}"
              BorderThickness="0,0,0,1">
        <TextBlock x:Name="UnderlinedText" FontSize="18" Text="This whole line is underlined" />
      </Border>
    </StackPanel>

    <StackPanel Spacing="2">
      <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Accent-coloured link look" />
      <Border HorizontalAlignment="Left"
              BorderBrush="{Binding Foreground, ElementName=LinkText}"
              BorderThickness="0,0,0,1">
        <TextBlock x:Name="LinkText"
                   FontSize="18"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                   Text="Looks like a link" />
      </Border>
    </StackPanel>

    <StackPanel Spacing="2">
      <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Strikethrough with an overlaid Rectangle (if Strikethrough is also broken)" />
      <Grid HorizontalAlignment="Left">
        <TextBlock x:Name="StruckText" FontSize="18" Text="This line is struck through" />
        <Rectangle Height="1"
                   Margin="0,2,0,0"
                   VerticalAlignment="Center"
                   Fill="{Binding Foreground, ElementName=StruckText}" />
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
