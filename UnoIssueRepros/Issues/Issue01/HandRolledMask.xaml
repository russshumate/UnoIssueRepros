<UserControl x:Class="UnoIssueRepros.Issues.Issue01.HandRolledMask"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel MaxWidth="520" HorizontalAlignment="Left" Spacing="8">
    <TextBlock TextWrapping="WrapWholeWords">
      Hand-rolled masked input: BeforeTextChanging rejects anything that is not a digit or mask punctuation,
      and TextChanged reformats the digits. No toolkit extension involved.
    </TextBlock>

    <TextBox x:Name="PhoneBox"
             BeforeTextChanging="OnBeforeTextChanging"
             Header="Phone (hand-rolled mask)"
             PlaceholderText="(555) 123-4567"
             TextChanged="OnTextChanged" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Click="OnSimulate" Content="Simulate typing 5551234567" />
      <Button Click="OnClear" Content="Clear" />
    </StackPanel>
    <TextBlock x:Name="ResultText" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
