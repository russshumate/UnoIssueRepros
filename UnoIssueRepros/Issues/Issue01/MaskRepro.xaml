<UserControl x:Class="UnoIssueRepros.Issues.Issue01.MaskRepro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:CommunityToolkit.WinUI">

  <StackPanel MaxWidth="520" HorizontalAlignment="Left" Spacing="8">
    <TextBlock TextWrapping="WrapWholeWords">
      Type 5551234567 into the box. Expected: (555) 123-4567.
      On Uno every keystroke throws IndexOutOfRangeException inside the mask's handler and the text stays unformatted.
    </TextBlock>

    <!-- The whole repro: a plain TextBox with a static mask. No MVUX, no dialog, no styles. -->
    <TextBox x:Name="MaskedBox"
             Header="Phone (TextBoxExtensions.Mask)"
             ui:TextBoxExtensions.Mask="(999) 999-9999" />

    <TextBlock x:Name="ValueText" FontFamily="Consolas, Menlo, monospace" />

    <!-- Control case: the same typing into a TextBox without a mask. -->
    <TextBox x:Name="PlainBox" Header="Control: plain TextBox, no mask" />
  </StackPanel>
</UserControl>
