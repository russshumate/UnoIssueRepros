<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>Uno Issue Repros</ApplicationTitle>
    <ApplicationId>com.unoissuerepros.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>UnoIssueRepros</ApplicationPublisher>
    <Description>Minimal, self-contained reproductions of Uno Platform issues found in production use.</Description>

    <!--
      Hosting + MVUX + Navigation are here because several repros (12-16) are about
      Uno.Extensions behaviour. Navigation supplies FrameworkElement.GetServiceProvider().
    -->
    <UnoFeatures>
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Navigation;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- Issue 01: TextBoxExtensions.Mask lives in the Windows Community Toolkit extensions. -->
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
  </ItemGroup>

</Project>
