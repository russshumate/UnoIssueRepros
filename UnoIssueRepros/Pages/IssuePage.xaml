<Page x:Class="UnoIssueRepros.Pages.IssuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <Style x:Key="PaneStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12,16,16" />
    </Style>
  </Page.Resources>

  <Grid Padding="24,16,24,16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="BackButton" Click="OnBack" Content="← All issues" />
      <Button x:Name="PreviousButton" Click="OnPrevious" Content="Previous" />
      <Button x:Name="NextButton" Click="OnNext" Content="Next" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="4">
      <TextBlock x:Name="GroupText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="TitleText"
                 Style="{StaticResource SubtitleTextBlockStyle}"
                 IsTextSelectionEnabled="True"
                 TextWrapping="WrapWholeWords" />
      <TextBlock x:Name="SummaryText" IsTextSelectionEnabled="True" TextWrapping="WrapWholeWords" />
      <TextBlock x:Name="MetaText"
                 FontSize="12"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 IsTextSelectionEnabled="True"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid x:Name="PanesGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="*" />
        <ColumnDefinition x:Name="RightColumn" Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="TopRow" Height="*" />
        <RowDefinition x:Name="BottomRow" Height="0" />
      </Grid.RowDefinitions>

      <Border x:Name="ReproBorder" Style="{StaticResource PaneStyle}">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Repro" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
            <ContentPresenter x:Name="ReproHost" Margin="0,0,16,0" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Border x:Name="WorkaroundBorder" Grid.Column="1" Style="{StaticResource PaneStyle}">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Workaround" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
            <ContentPresenter x:Name="WorkaroundHost" Margin="0,0,16,0" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="RightColumn.Width" Value="0" />
            <Setter Target="BottomRow.Height" Value="*" />
            <Setter Target="WorkaroundBorder.(Grid.Column)" Value="0" />
            <Setter Target="WorkaroundBorder.(Grid.Row)" Value="1" />
            <Setter Target="PanesGrid.ColumnSpacing" Value="0" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Page>
