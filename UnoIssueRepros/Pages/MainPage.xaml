<Page x:Class="UnoIssueRepros.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <ScrollViewer VerticalScrollBarVisibility="Visible">
    <StackPanel MaxWidth="980"
                Padding="24,20,24,32"
                HorizontalAlignment="Stretch"
                Spacing="4">
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Uno Issue Repros" />
      <TextBlock TextWrapping="WrapWholeWords">
        Minimal repros of Uno Platform issues found while building a production app. Every page has a
        Repro pane and a Workaround pane. Repros that crash run in a child copy of this app, so this
        launcher survives. Tooling issues come with written steps.
      </TextBlock>
      <TextBlock x:Name="EnvironmentText"
                 Margin="0,8,0,4"
                 FontFamily="Consolas, Menlo, monospace"
                 FontSize="12"
                 IsTextSelectionEnabled="True"
                 TextWrapping="Wrap" />
      <StackPanel x:Name="GroupsPanel" Spacing="4" />
    </StackPanel>
  </ScrollViewer>
</Page>
